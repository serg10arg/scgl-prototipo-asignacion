# Plantilla de configuracion de conexion a MySQL.
# Copiar este archivo como config.properties (en la misma carpeta) y completar
# con las credenciales de tu entorno local antes de ejecutar la App.
# RNF9: solo driver JDBC, sin frameworks.
db.url=jdbc:mysql://localhost:3306/scgl?serverTimezone=America/Argentina/Buenos_Aires
db.usuario=TU_USUARIO
db.password=TU_PASSWORD
